# ForceFieldEngine Configuration Environment Variables Example
# Copy this file to '.env' and modify settings as needed.
# All settings have sensible defaults built-in.

# ── Window Defaults ──────────────────────────────────────────────────────────
# Default window size (must be positive integers)
QE_DEFAULT_WINDOW_WIDTH=1280
QE_DEFAULT_WINDOW_HEIGHT=720

# Window title string
QE_WINDOW_TITLE="ForceFieldEngine"

# OpenGL version (Major >= 1, Minor >= 0)
QE_GL_MAJOR_VERSION=3
QE_GL_MINOR_VERSION=3

# Multi-Sample Anti-Aliasing samples (0 to disable)
QE_MSAA_SAMPLES=4

# ── Timing & Physics ─────────────────────────────────────────────────────────
# Maximum frame delta-time cap (seconds) to prevent physics explosions on lag
QE_MAX_DELTA_TIME=0.1

# Default gravity acceleration (m/s^2)
QE_DEFAULT_GRAVITY=-9.8

# ── Rendering & Visuals ──────────────────────────────────────────────────────
# RGBA clear color (floats in range [0.0, 1.0])
QE_CLEAR_R=0.02
QE_CLEAR_G=0.02
QE_CLEAR_B=0.06
QE_CLEAR_A=1.0

# Fog distance limits (near >= 0.0, far >= near)
QE_FOG_NEAR=30.0
QE_FOG_FAR=80.0

# Rim lighting power factor (positive float)
QE_RIM_POWER=3.0

# Maximum number of concurrent point lights (positive integer)
QE_MAX_POINT_LIGHTS=8

# ── Camera Defaults ──────────────────────────────────────────────────────────
# Camera interpolation smoothing (must be in range [0.0, 1.0))
QE_DEFAULT_CAMERA_SMOOTHING=0.85

# Camera movement base speed (positive float)
QE_DEFAULT_CAMERA_MOVE_SPEED=5.0

# Camera sprint multiplier when holding Shift (positive float)
QE_DEFAULT_CAMERA_SPRINT_MULT=2.5

# Camera mouse sensitivity (positive float)
QE_DEFAULT_CAMERA_SENSITIVITY=0.003

# TPS camera orbit settings
QE_DEFAULT_ORBIT_DISTANCE=5.0
QE_DEFAULT_ORBIT_HEIGHT=2.0
QE_DEFAULT_ORBIT_SMOOTHING=0.9

# ── Gameplay ─────────────────────────────────────────────────────────────────
# Interval between FPS updates in the window title bar (seconds)
QE_FPS_UPDATE_INTERVAL=0.5

# Projectile lifetime (seconds) and radius (meters)
QE_PROJECTILE_LIFETIME=3.0
QE_PROJECTILE_RADIUS=0.08

# Points awarded per kill (non-negative integer)
QE_KILL_SCORE=100

# Gamepad look look speed factor (positive float)
QE_GAMEPAD_LOOK_SPEED=5.0
